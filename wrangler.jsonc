// Cloudflare Workers Builds: a static site, no Worker code. `npm ci` builds dist/ through the
// package's prepare script (sh tools/build_site.sh dist: index.html, styles/ and src/), so it exists
// whatever the dashboard's build command; `npx wrangler deploy` (main) and `npx wrangler preview`
// (other branches) upload that folder as the site's assets.
{
  "name": "ascii-meadow",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist"
  },
  // required by `wrangler preview`, which builds the non-production branches; may stay empty
  "previews": {}
}
