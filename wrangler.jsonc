// Cloudflare Workers Builds. `npm ci` builds dist/ through the package's prepare script
// (sh tools/build_site.sh dist: index.html, styles/ and src/), whatever the dashboard's build command;
// `npx wrangler deploy` (main) and `npx wrangler preview` (other branches) upload it as the site's assets.
// The Worker (worker/index.mjs) only answers /api/*: the map editor's «Сохранить», which commits the map
// to GitHub. Everything else is served straight from dist/ without running it.
{
  "name": "ascii-meadow",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // required by `wrangler preview`, which builds the non-production branches; may stay empty
  "previews": {}
}
