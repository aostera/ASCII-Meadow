#!/bin/sh
# Fail closed: check exactly the staged versions before a commit is recorded.
set -eu
if command -v python3 >/dev/null 2>&1; then
  exec python3 tools/check/staged-secrets.py
elif command -v python >/dev/null 2>&1; then
  exec python tools/check/staged-secrets.py
else
  echo 'BLOCKED COMMIT: Python is required for secret scanning.' >&2
  exit 2
fi
